# URL canônica em produção (sitemap, Open Graph, JSON-LD, /llms.txt).
# Na Vercel, se ficar vazio, o app usa VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=https://seu-dominio.vercel.app

# Senha das telas /fontes e /cadastrar e das rotas que alteram a base.
# Gere com: openssl rand -hex 32
# Também aceita TRILHA_ADMIN_SECRET (alias).
TRILHA_ADMIN_SECRET=

# Vercel Cron envia Authorization: Bearer $CRON_SECRET em GET /api/coletar.
# Sem isso, a coleta horária em produção responde 401.
# Também aceita CRON_SECRET (alias).
CRON_SECRET=

# Redis (Upstash) — obrigatório na Vercel para chaves e cotas sobreviverem
# entre instâncias. Marketplace: vercel integration add upstash
# Localmente, sem isso, usa memória + data/chaves.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
